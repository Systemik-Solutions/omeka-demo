---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import Icon from "../components/Icon.astro";
import { contactEmail, signupUrl, url } from "../lib/site";
const page = await getEntry("pages", "contact");
if (!page || page.data.template !== "contact") {
  throw new Error("The contact page requires src/content/pages/contact.md with template: contact.");
}
const content = page.data;
const { Content } = await render(page);
---

<BaseLayout title={content.title} description={content.summary}>
  <PageBanner
    title={content.banner.title}
    summary={content.banner.summary}
  />
  <section class="section">
    <div class="container contact-layout">
      <div class="contact-copy">
        <p class="eyebrow">{content.eyebrow}</p>
        <h2>
          {content.heading.map((line, index) => (
            <>{index > 0 && <br />}{line}</>
          ))}
        </h2>
        <Content />
        <a class="text-link" href={url(content.guideLink.path)}>
          {content.guideLink.label} <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="contact-panel">
        <img src={url("/brand/mark.svg")} alt="" width="145" height="98" />
        <h2>{content.panel.title}</h2>
        {signupUrl ? (
          <>
            <p>{content.panel.signup.description}</p>
            <a class="button button-gold" href={signupUrl}>
              {content.panel.signup.label} <Icon name="external" size={18} />
            </a>
            <p class="small-text">{content.panel.signup.note}</p>
          </>
        ) : contactEmail ? (
          <>
            <p>{content.panel.email.description}</p>
            <a
              class="button button-gold"
              href={`mailto:${contactEmail}?subject=${encodeURIComponent(content.panel.email.subject)}`}
            >
              {content.panel.email.label} <Icon name="mail" size={18} />
            </a>
            <p class="small-text">{contactEmail}</p>
          </>
        ) : (
          <>
            <p>{content.panel.fallback.description}</p>
            <a class="button button-gold" href={content.panel.fallback.url}>
              {content.panel.fallback.label} <Icon name="external" size={18} />
            </a>
            <p class="small-text">{content.panel.fallback.note}</p>
          </>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
