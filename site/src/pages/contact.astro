---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import Icon from "../components/Icon.astro";
import { contactEmail, signupUrl, programmeUrl, url } from "../lib/site";
---

<BaseLayout
  title="Register your interest"
  description="Talk to us about publishing, migrating or maintaining your research collection."
>
  <PageBanner
    title="Let’s start a conversation"
    summary="Tell us about your collection and what you would like to make possible."
  />
  <section class="section">
    <div class="container contact-layout">
      <div class="contact-copy">
        <p class="eyebrow">Register your interest</p>
        <h2>
          Your research.
          <br />A lasting collection.
        </h2>
        <p>
          Whether you have a new project, an existing collection to migrate, or
          a question about the platform, we’d like to hear from you.
        </p>
        <h3>Helpful things to share</h3>
        <ul>
          <li>Your name, institution and research area</li>
          <li>A short description of your collection</li>
          <li>Your existing website or data format, if you have one</li>
          <li>The support you need and your project timeline</li>
        </ul>
        <a class="text-link" href={url("/getting-started/")}>
          Find out how to get started <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="contact-panel">
        <img src={url("/brand/mark.svg")} alt="" width="145" height="98" />
        <h2>Connect with the project</h2>
        {signupUrl ? (
          <>
            <p>
              Complete the registration form to tell the team about your
              research and the support you’re looking for.
            </p>
            <a class="button button-gold" href={signupUrl}>
              Register your interest <Icon name="external" size={18} />
            </a>
            <p class="small-text">
              The form opens on our registration provider’s website.
            </p>
          </>
        ) : contactEmail ? (
          <>
            <p>
              Get in touch to discuss your collection, ask a question or express
              interest in the platform.
            </p>
            <a
              class="button button-gold"
              href={`mailto:${contactEmail}?subject=Curated%20Collections%20enquiry`}
            >
              Email the project team <Icon name="mail" size={18} />
            </a>
            <p class="small-text">{contactEmail}</p>
          </>
        ) : (
          <>
            <p>
              Curated Collections is part of the ARDC Community Data Lab. Find
              programme information and contact options through ARDC.
            </p>
            <a class="button button-gold" href={programmeUrl}>
              Visit the Community Data Lab <Icon name="external" size={18} />
            </a>
            <p class="small-text">
              A dedicated registration form will be available here when
              registration opens.
            </p>
          </>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
