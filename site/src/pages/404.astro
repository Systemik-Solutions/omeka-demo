---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../lib/site";
const page = await getEntry("pages", "404");
if (!page || page.data.template !== "not-found") throw new Error("Missing 404 page Markdown.");
const content = page.data;
---

<BaseLayout title={content.title} description={content.summary}>
  <section class="section">
    <div class="container not-found">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>{content.heading}</h1>
      <p>{content.description}</p>
      <div class="hero-actions">
        <a class="button button-gold" href={url(content.primaryAction.path)}>
          {content.primaryAction.label}
        </a>
        <a class="button button-outline" href={url(content.secondaryAction.path)}>
          {content.secondaryAction.label}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
