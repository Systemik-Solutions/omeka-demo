---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import Partners from "../components/Partners.astro";
import EnquiryBanner from "../components/EnquiryBanner.astro";
import { url } from "../lib/site";
import { getSiteContent } from "../lib/content";
export async function getStaticPaths() {
  const pages = await getCollection("pages", ({ data }) => data.template === "text" || data.template === "about");
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}
const { page } = Astro.props;
const { textPage } = await getSiteContent();
const { Content, headings } = await render(page);
const sections = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={page.data.title} description={page.data.summary}>
  <PageBanner title={page.data.title} summary={page.data.summary} />
  <div
    class:list={[
      "container",
      "content-layout",
      { "about-content": page.data.template === "about" },
    ]}
  >
    <aside class="content-aside">
      <a class="breadcrumb" href={url("/")}>
        {textPage.homeLabel}
      </a>
      <span aria-hidden="true"> / </span>
      <span>{page.data.eyebrow}</span>
      <nav aria-label={textPage.contentsLabel}>
        <p class="eyebrow">{textPage.contentsLabel}</p>
        {sections.map((section) => (
          <a href={`#${section.slug}`}>{section.text}</a>
        ))}
      </nav>
    </aside>
    <article class="prose">
      <Content />
    </article>
  </div>
  {page.data.template === "about" && (
    <>
      <Partners />
      <EnquiryBanner />
    </>
  )}
</BaseLayout>
