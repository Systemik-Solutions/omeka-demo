---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import FeatureCard from "../components/FeatureCard.astro";
import EnquiryBanner from "../components/EnquiryBanner.astro";
const page = await getEntry("pages", "features");
if (!page || page.data.template !== "features") throw new Error("Missing features page Markdown.");
const content = page.data;
const features = (await getCollection("features")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={content.title} description={content.summary}>
  <PageBanner
    title={content.banner.title}
    summary={content.banner.summary}
  />
  <section class="section features-section">
    <div class="container">
      <p class="eyebrow">{content.eyebrow}</p>
      <h2 class="spaced-heading">{content.heading}</h2>
      <div class="feature-grid">
        {features.map((feature) => (
          <FeatureCard feature={feature} />
        ))}
      </div>
    </div>
  </section>
  <EnquiryBanner />
</BaseLayout>
