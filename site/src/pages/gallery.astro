---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Icon from "../components/Icon.astro";
import { getInstitutions } from "../lib/projects";
const page = await getEntry("pages", "gallery");
if (!page || page.data.template !== "gallery") throw new Error("Missing gallery page Markdown.");
const content = page.data;
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const tags = [
  content.filters.all,
  ...new Set(projects.flatMap((p) => p.data.tags).sort()),
];
const institutions = [
  ...new Set(projects.flatMap((project) => getInstitutions(project.data.institution))),
].sort((a, b) => a.localeCompare(b));
---

<BaseLayout title={content.title} description={content.summary}>
  <PageBanner
    title={content.banner.title}
    summary={content.banner.summary}
  />
  <section class="gallery-page section">
    <div class="container">
      <p class="eyebrow">{content.eyebrow}</p>
      <h2>{content.heading}</h2>
      <p class="gallery-intro">
        {content.introduction}
      </p>
      <div class="gallery-tools" hidden>
        <div
          class="filter-buttons"
          role="group"
          aria-label={content.filters.label}
        >
          {tags.map((tag, i) => (
            <button
              type="button"
              class="filter-button"
              data-filter={i === 0 ? "" : tag}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              {tag}
            </button>
          ))}
        </div>
        <label class="institution-filter">
          <span class="sr-only">{content.filters.institution.label}</span>
          <select name="institution">
            <option value="">{content.filters.institution.all}</option>
            {institutions.map((institution) => (
              <option value={institution}>{institution}</option>
            ))}
          </select>
          <Icon name="chevron" size={18} class="institution-filter-arrow" />
        </label>
        <label class="search-field">
          <Icon name="search" size={19} />
          <span class="sr-only">{content.search.label}</span>
          <input
            type="search"
            name="search"
            placeholder={content.search.placeholder}
            autocomplete="off"
          />
        </label>
      </div>
      <p
        class="results-count"
        data-messages={JSON.stringify(content.results)}
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        {content.results.plural.replace("{count}", String(projects.length))}
      </p>
      <div class="project-grid">
        {projects.map((project, index) => (
          <ProjectCard project={project} eager={index < 3} />
        ))}
      </div>
      <div class="empty-state" hidden>
        <Icon name="search" size={36} />
        <h3>{content.empty.title}</h3>
        <p>{content.empty.description}</p>
        <button type="button" class="button button-outline" data-reset>
          {content.empty.resetLabel}
        </button>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  const tools = document.querySelector<HTMLElement>(".gallery-tools");
  if (tools) {
    tools.hidden = false;
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-filter]"),
    );
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-project]"),
    );
    const input = document.querySelector<HTMLInputElement>(
      'input[type="search"]',
    )!;
    const institution = document.querySelector<HTMLSelectElement>(
      'select[name="institution"]',
    )!;
    const status = document.querySelector<HTMLElement>(".results-count")!;
    const messages = JSON.parse(status.dataset.messages!) as {
      singular: string;
      plural: string;
      disciplineSuffix: string;
      institutionSuffix: string;
      searchSuffix: string;
    };
    const empty = document.querySelector<HTMLElement>(".empty-state")!;
    let active = "";
    const update = (syncUrl = true) => {
      let count = 0;
      const query = input.value.trim().toLowerCase();
      cards.forEach((card) => {
        const tags = JSON.parse(card.dataset.tags || "[]") as string[];
        const institutions = JSON.parse(card.dataset.institutions || "[]") as string[];
        const matches =
          (!active || tags.includes(active)) &&
          (!institution.value || institutions.includes(institution.value)) &&
          (!query || card.dataset.search?.includes(query));
        card.hidden = !matches;
        if (matches) count++;
      });
      buttons.forEach((button) =>
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.filter === active),
        ),
      );
      status.textContent =
        (count === 1 ? messages.singular : messages.plural).replace("{count}", String(count)) +
        (active ? messages.disciplineSuffix.replace("{discipline}", active) : "") +
        (institution.value ? messages.institutionSuffix.replace("{institution}", institution.value) : "") +
        (query ? messages.searchSuffix.replace("{query}", input.value.trim()) : "");
      empty.hidden = count > 0;
      if (syncUrl) {
        const next = new URL(location.href);
        active
          ? next.searchParams.set("discipline", active)
          : next.searchParams.delete("discipline");
        institution.value
          ? next.searchParams.set("institution", institution.value)
          : next.searchParams.delete("institution");
        query
          ? next.searchParams.set("q", input.value.trim())
          : next.searchParams.delete("q");
        history.replaceState(null, "", next);
      }
    };
    const restore = () => {
      const params = new URLSearchParams(location.search);
      const requested = params.get("discipline") || "";
      active = buttons.some((b) => b.dataset.filter === requested)
        ? requested
        : "";
      const requestedInstitution = params.get("institution") || "";
      institution.value = Array.from(institution.options).some(
        (option) => option.value === requestedInstitution,
      ) ? requestedInstitution : "";
      input.value = params.get("q") || "";
      update(false);
    };
    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        active = button.dataset.filter || "";
        update();
      }),
    );
    input.addEventListener("input", () => update());
    institution.addEventListener("change", () => update());
    document.querySelector("[data-reset]")?.addEventListener("click", () => {
      active = "";
      institution.value = "";
      input.value = "";
      update();
      input.focus();
    });
    window.addEventListener("popstate", restore);
    restore();
  }
</script>
