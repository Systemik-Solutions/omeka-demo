---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureCard from "../components/FeatureCard.astro";
import ProjectCarousel from "../components/ProjectCarousel.astro";
import Partners from "../components/Partners.astro";
import EnquiryBanner from "../components/EnquiryBanner.astro";
import Icon from "../components/Icon.astro";
import { url } from "../lib/site";
const features = (await getCollection("features")).sort(
  (a, b) => a.data.order - b.data.order,
);
const projects = (
  await getCollection("projects", ({ data }) => data.featured)
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>Curated Collections</h1>
        <p>
          An enduring web publishing platform solution for HASS and Indigenous
          research data collections.
        </p>
        <div class="hero-actions">
          <a class="button button-gold" href={url("/getting-started/")}>
            Get started <Icon name="arrow" size={18} />
          </a>
          <a class="button button-outline" href={url("/gallery/")}>
            Explore projects
          </a>
        </div>
      </div>
      <img
        class="hero-mark"
        src={url("/brand/mark.svg")}
        alt=""
        width="380"
        height="255"
        fetchpriority="high"
      />
    </div>
  </section>
  <section class="introduction" aria-labelledby="intro-heading">
    <div class="container">
      <div class="intro-row">
        <div>
          <p class="eyebrow">What is Curated Collections?</p>
          <h2 id="intro-heading">
            A sustainable platform to manage and publish digital collections.
          </h2>
        </div>
        <p class="intro-description">
          Curated Collections is a platform service which empowers researchers
          to build, publish and maintain collections without specialised
          technical skills. We provide training and support for researchers,
          assist with migration of existing collections, support the integration
          of Omeka S with national HASS infrastructure, and develop specialised
          modules.
        </p>
      </div>
      <div class="principles">
        <div>
          <h3>
            HASS &amp; Indigenous
            <br />
            Collections
          </h3>
          <p>
            Working with Humanities, Arts &amp; Social Sciences research
            collections.
          </p>
        </div>
        <div>
          <h3>Open Source</h3>
          <p>
            Built using Omeka S, an open source, humanities-dedicated web
            platform.
          </p>
        </div>
        <div>
          <h3>Made to Last</h3>
          <p>
            Preserve and sustain research collections through robust linked data
            protocols.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="features-section section" aria-labelledby="features-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Features</p>
          <h2 id="features-heading">
            Built to make research open,
            <br class="desktop-break" /> accessible and reusable
          </h2>
        </div>
        <a class="text-link" href={url("/features/")}>
          View all features <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="feature-grid">
        {features.map((feature) => (
          <FeatureCard feature={feature} />
        ))}
      </div>
    </div>
  </section>
  <EnquiryBanner />
  <section class="gallery-section section" aria-labelledby="gallery-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Gallery</p>
          <h2 id="gallery-heading">
            Collections empowered
            <br class="desktop-break" /> by public discovery
          </h2>
        </div>
        <a class="text-link" href={url("/gallery/")}>
          View gallery <Icon name="arrow" size={18} />
        </a>
      </div>
      <ProjectCarousel projects={projects} />
    </div>
  </section>
  <Partners />
</BaseLayout>
