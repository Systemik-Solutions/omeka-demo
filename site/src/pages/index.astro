---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureCard from "../components/FeatureCard.astro";
import ProjectCarousel from "../components/ProjectCarousel.astro";
import Partners from "../components/Partners.astro";
import EnquiryBanner from "../components/EnquiryBanner.astro";
import Icon from "../components/Icon.astro";
import HeadingLines from "../components/HeadingLines.astro";
import { url } from "../lib/site";
const page = await getEntry("pages", "home");
if (!page || page.data.template !== "home") throw new Error("Missing home page Markdown.");
const content = page.data;
const features = (await getCollection("features")).sort(
  (a, b) => a.data.order - b.data.order,
);
const projects = (
  await getCollection("projects", ({ data }) => data.featured)
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout description={content.summary}>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>{content.title}</h1>
        <p>{content.hero.description}</p>
        <div class="hero-actions">
          <a class="button button-gold" href={url(content.hero.primaryAction.path)}>
            {content.hero.primaryAction.label} <Icon name="arrow" size={18} />
          </a>
          <a class="button button-outline" href={url(content.hero.secondaryAction.path)}>
            {content.hero.secondaryAction.label}
          </a>
        </div>
      </div>
      <img
        class="hero-mark"
        src={url("/brand/mark.svg")}
        alt=""
        width="380"
        height="255"
        fetchpriority="high"
      />
    </div>
  </section>
  <section class="introduction" aria-labelledby="intro-heading">
    <div class="container">
      <div class="intro-row">
        <div>
          <p class="eyebrow">{content.eyebrow}</p>
          <h2 id="intro-heading">
            {content.introduction.title}
          </h2>
        </div>
        <p class="intro-description">
          {content.introduction.description}
        </p>
      </div>
      <div class="principles">
        {content.introduction.principles.map((principle) => (
          <div>
            <h3><HeadingLines lines={principle.heading} /></h3>
            <p>{principle.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="features-section section" aria-labelledby="features-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{content.features.eyebrow}</p>
          <h2 id="features-heading">
            <HeadingLines lines={content.features.heading} breakClass="desktop-break" />
          </h2>
        </div>
        <a class="text-link" href={url(content.features.link.path)}>
          {content.features.link.label} <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="feature-grid">
        {features.map((feature) => (
          <FeatureCard feature={feature} />
        ))}
      </div>
    </div>
  </section>
  <EnquiryBanner />
  <section class="gallery-section section" aria-labelledby="gallery-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{content.gallery.eyebrow}</p>
          <h2 id="gallery-heading">
            <HeadingLines lines={content.gallery.heading} breakClass="desktop-break" />
          </h2>
        </div>
        <a class="text-link" href={url(content.gallery.link.path)}>
          {content.gallery.link.label} <Icon name="arrow" size={18} />
        </a>
      </div>
      <ProjectCarousel projects={projects} />
    </div>
  </section>
  <Partners />
</BaseLayout>
