---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { url } from "../lib/site";
import "../styles/global.css";
import fontUrl from "../assets/fonts/host-grotesk-latin.woff2?url";
interface Props {
  title?: string;
  description?: string;
}
const {
  title,
  description = "An enduring web publishing platform for HASS and Indigenous research data collections.",
} = Astro.props;
const fullTitle = title
  ? `${title} | Curated Collections`
  : "Curated Collections — Research collections, made to last";
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5fb2b2" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={url("/brand/mark.svg")} />
    <link
      rel="preload"
      href={fontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
