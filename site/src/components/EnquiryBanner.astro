---
import { url } from "../lib/site";
import { getSiteContent } from "../lib/content";
import Icon from "./Icon.astro";
const { enquiry } = await getSiteContent();
---

<section class="enquiry-banner" aria-labelledby="enquiry-heading">
  <div class="container enquiry-inner">
    <h2 id="enquiry-heading">
      {enquiry.title}
    </h2>
    <a href={url(enquiry.link.path)} class="enquiry-link">
      {enquiry.link.label} <Icon name="arrow" size={54} />
    </a>
  </div>
</section>
