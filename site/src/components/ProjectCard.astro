---
import type { CollectionEntry } from "astro:content";
import { url } from "../lib/site";
import { getSiteContent } from "../lib/content";
import Icon from "./Icon.astro";
interface Props {
  project: CollectionEntry<"projects">;
  eager?: boolean;
}
const { project, eager = false } = Astro.props;
const p = project.data;
const { projectCard: labels } = await getSiteContent();
---

<article
  class="project-card"
  data-project
  data-tags={JSON.stringify(p.tags)}
  data-search={`${p.title} ${p.summary} ${p.institution}`.toLowerCase()}
>
  <a
    class="project-image"
    href={url(`/projects/${project.id}/`)}
    tabindex="-1"
    aria-hidden="true"
  >
    {p.image && (
      <img
        src={url(p.image)}
        alt=""
        width="826"
        height="448"
        loading={eager ? "eager" : "lazy"}
      />
    )}
  </a>
  <div class="project-tags">
    {p.tags.slice(0, 3).map((tag) => (
      <span>{tag}</span>
    ))}
  </div>
  <div class="project-body">
    <p class="project-institution">
      {p.institution ||
        (p.status === "coming-soon" ? labels.inDevelopmentLabel : labels.researchLabel)}
    </p>
    <h3>
      <a href={url(`/projects/${project.id}/`)}>{p.title}</a>
    </h3>
    <p class="project-summary">{p.summary}</p>
    <a
      href={url(`/projects/${project.id}/`)}
      class="button button-outline project-button"
      aria-label={labels.discoverAriaLabel.replace("{title}", p.title)}
    >
      {labels.discoverLabel} <Icon name="arrow" size={17} />
    </a>
  </div>
</article>
