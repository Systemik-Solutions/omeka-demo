---
import { url } from "../lib/site";
import { getSiteContent } from "../lib/content";
const { partners } = await getSiteContent();
---

<section class="partners section" aria-labelledby="partners-heading">
  <div class="container">
    <p class="eyebrow">{partners.eyebrow}</p>
    <h2 id="partners-heading">{partners.title}</h2>
    <div class="partner-grid">
      {partners.items.map((partner) => (
        <a class="partner" href={partner.url} aria-label={partner.label}>
          <img
            src={url(partner.image)}
            alt={partner.imageAlt}
            width={partner.width}
            height={partner.height}
            loading="lazy"
          />
        </a>
      ))}
    </div>
  </div>
</section>
