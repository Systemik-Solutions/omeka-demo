---
import { url } from "../lib/site";
import { getEntry, render } from "astro:content";
const home = await getEntry("pages", "home");
if (!home || home.data.template !== "home") throw new Error("Missing home page Markdown.");
const { partners } = home.data;
const { Content } = await render(home);
const hasCopy = Boolean(home.body?.replace(/<!--[\s\S]*?-->/g, "").trim());
---

<section class="partners section" aria-labelledby="partners-heading">
  <div class="container">
    <p class="eyebrow">{partners.eyebrow}</p>
    <h2 id="partners-heading">{partners.title}</h2>
    <div class="partner-grid">
      {partners.items.map((partner) => (
        <a class="partner" href={partner.url} aria-label={partner.label}>
          <img
            src={url(partner.image)}
            alt={partner.imageAlt}
            loading="lazy"
          />
        </a>
      ))}
    </div>
    {hasCopy && (
      <div class="partners-copy">
        <Content />
      </div>
    )}
  </div>
</section>
