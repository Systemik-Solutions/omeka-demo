---
import { url } from "../lib/site";
import { getSiteContent } from "../lib/content";
import Icon from "./Icon.astro";
const { navigation, footer, registration } = await getSiteContent();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-identity">
        <a href={url("/")}>
          <img
            src={url("/brand/logo-light.svg")}
            alt={footer.logoAlt}
            width="420"
            height="48"
            loading="lazy"
          />
        </a>
        <p>{footer.tagline}</p>
      </div>
      <nav class="footer-nav" aria-label={footer.navigationLabel}>
        <p class="eyebrow">{footer.exploreLabel}</p>
        {navigation.map((item) => (
          <a href={url(item.path)}>{item.label}</a>
        ))}
      </nav>
      <nav class="footer-nav" aria-label={footer.informationLabel}>
        <p class="eyebrow">{footer.informationLabel}</p>
        {footer.informationLinks.map((item) => (
          <a href={url(item.path)}>{item.label}</a>
        ))}
      </nav>
    </div>
    <div class="footer-bottom">
      <div class="legal-links">
        {footer.legalLinks.map((item, index) => (
          <>
            {index > 0 && <span>·</span>}
            <a href={url(item.path)}>{item.label}</a>
          </>
        ))}
      </div>
      <a class="button button-small button-gold" href={url(registration.path)}>
        {registration.label} <Icon name="arrow" size={15} />
      </a>
    </div>
  </div>
</footer>
