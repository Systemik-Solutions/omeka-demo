---
import { url } from "../lib/site";

interface Props {
  label: string;
  logos: { image: string; imageAlt: string }[];
}

const { label, logos } = Astro.props;
---

<section class="acknowledgement" aria-label={label}>
  <div class="container">
    {logos.length > 0 && (
      <div class="acknowledgement-logos">
        {logos.map((logo) => (
          <img src={url(logo.image)} alt={logo.imageAlt} loading="lazy" />
        ))}
      </div>
    )}
    <div class="acknowledgement-copy">
      <slot />
    </div>
  </div>
</section>
